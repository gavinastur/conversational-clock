{
  "name": "conversational-clock",
  "version": "1.0.0",
  "description": "Tells the time the way people say it, e.g. \"just after half past seven am\".",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "conversational-clock": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
